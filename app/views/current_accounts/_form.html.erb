<%= form_with model: current_account, class: "card space-y-4" do |form| %>
  <% if current_account.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-inside list-disc">
        <% current_account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="<%= CurrentAccount.human_attribute_name(:type_launche) %>">
    <label class="flex cursor-pointer items-center justify-center rounded-md border border-slate-300 py-3 font-medium text-slate-600 has-checked:border-red-600 has-checked:bg-red-600 has-checked:text-white">
      <%= form.radio_button :type_launche, :debito, class: "sr-only" %> Débito
    </label>
    <label class="flex cursor-pointer items-center justify-center rounded-md border border-slate-300 py-3 font-medium text-slate-600 has-checked:border-emerald-600 has-checked:bg-emerald-600 has-checked:text-white">
      <%= form.radio_button :type_launche, :credito, class: "sr-only" %> Crédito
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :price, class: "label" %>
      <%= form.number_field :price, step: 0.01, min: 0.01, placeholder: "0,00", inputmode: "decimal", autofocus: current_account.new_record?, class: "input text-lg font-semibold" %>
    </div>

    <div>
      <%= form.label :date_ocurrence, class: "label" %>
      <%= form.date_field :date_ocurrence, class: "input" %>
    </div>

    <div>
      <%= form.label :cost_id, class: "label" %>
      <%= form.select :cost_id, CurrentAccount::COSTS.invert, { prompt: "Selecione" }, class: "input" %>
    </div>

    <div>
      <%= form.label :cash_account_id, class: "label" %>
      <%= form.select :cash_account_id, CurrentAccount::CASH_ACCOUNTS.invert, { prompt: "Selecione" }, class: "input" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :historic, class: "label" %>
      <%= form.text_field :historic, class: "input" %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 sm:flex-row">
    <%= link_to "Cancelar", current_account.persisted? ? current_account : current_accounts_path, class: "btn-secondary py-3 sm:py-2" %>
    <%= form.submit "Salvar", class: "btn-primary py-3 sm:order-first sm:py-2" %>
  </div>
<% end %>
