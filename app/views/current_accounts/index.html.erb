<% content_for :title, "Conta Corrente" %>

<div class="mb-4 flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Conta Corrente</h1>
    <p class="mt-1 text-sm text-slate-600"><%= @date ? "Saldo do dia #{l(@date)}" : "Saldo total" %></p>
    <%= tag.p number_to_currency(@balance), class: "text-2xl font-bold #{@balance.negative? ? "text-red-700" : "text-emerald-700"}" %>
  </div>

  <%= link_to "Novo lançamento", new_current_account_path, class: "btn-primary hidden sm:inline-flex" %>
</div>

<%= form_with url: current_accounts_path, method: :get, class: "mb-4 flex items-end gap-2" do |form| %>
  <div class="min-w-0 flex-1 sm:flex-none">
    <%= form.label :date, "Consultar saldo do dia", class: "label" %>
    <%= form.date_field :date, value: @date, class: "input" %>
  </div>
  <%= form.submit "Consultar", name: nil, class: "btn-secondary" %>
  <%= link_to "Limpar", current_accounts_path, class: "btn-secondary" if @date %>
<% end %>

<% if @current_accounts.empty? %>
  <p class="card text-center text-sm text-slate-500">Nenhum lançamento encontrado.</p>
<% else %>
  <%# Mobile: cards %>
  <ul class="divide-y divide-slate-100 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm sm:hidden">
    <% @current_accounts.each do |current_account| %>
      <li>
        <%= link_to current_account, class: "flex items-center justify-between gap-3 px-4 py-3 active:bg-slate-50" do %>
          <div class="min-w-0">
            <p class="truncate font-medium"><%= current_account.name_cost %></p>
            <p class="truncate text-xs text-slate-500">
              <%= l(current_account.date_ocurrence, format: "%d/%m") %> · <%= current_account.name_account %><%= " · #{current_account.historic}" if current_account.historic.present? %>
            </p>
          </div>
          <span class="shrink-0 font-semibold <%= current_account.credito? ? "text-emerald-700" : "text-red-700" %>">
            <%= number_to_currency(current_account.signed_price) %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%# Desktop: table %>
  <div class="hidden overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm sm:block">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3">Data</th>
          <th class="px-4 py-3">Conta</th>
          <th class="px-4 py-3">Categoria</th>
          <th class="px-4 py-3">Histórico</th>
          <th class="px-4 py-3 text-right">Valor</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <%= render @current_accounts %>
      </tbody>
    </table>
  </div>
<% end %>

<nav class="mt-4 flex justify-between gap-3">
  <%= link_to "← Mais recentes", current_accounts_path(date: @date, page: @page - 1), class: "btn-secondary" if @page > 1 %>
  <%= link_to "Mais antigos →", current_accounts_path(date: @date, page: @page + 1), class: "btn-secondary ml-auto" if @next_page %>
</nav>
