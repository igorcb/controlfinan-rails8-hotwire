<% content_for :title, "Conta Corrente" %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Conta Corrente</h1>
    <p class="mt-1 text-sm text-slate-600">
      <%= @date ? "Saldo do dia #{l(@date)}" : "Saldo total" %>:
      <%= tag.strong number_to_currency(@balance), class: @balance.negative? ? "text-red-700" : "text-emerald-700" %>
    </p>
  </div>

  <%= link_to "Novo lançamento", new_current_account_path, class: "btn-primary" %>
</div>

<%= form_with url: current_accounts_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do |form| %>
  <div>
    <%= form.label :date, "Consultar saldo do dia", class: "label" %>
    <%= form.date_field :date, value: @date, class: "input" %>
  </div>
  <%= form.submit "Consultar", name: nil, class: "btn-secondary" %>
  <%= link_to "Limpar", current_accounts_path, class: "link text-sm" if @date %>
<% end %>

<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Data</th>
        <th class="px-4 py-3">Conta</th>
        <th class="px-4 py-3">Categoria</th>
        <th class="px-4 py-3">Histórico</th>
        <th class="px-4 py-3 text-right">Valor</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody id="current_accounts" class="divide-y divide-slate-100">
      <%= render(@current_accounts) || tag.tr(tag.td("Nenhum lançamento encontrado.", colspan: 6, class: "px-4 py-6 text-center text-slate-500")) %>
    </tbody>
  </table>
</div>

<nav class="mt-4 flex justify-between text-sm">
  <%= link_to "← Mais recentes", current_accounts_path(date: @date, page: @page - 1), class: "link" if @page > 1 %>
  <%= link_to "Mais antigos →", current_accounts_path(date: @date, page: @page + 1), class: "link ml-auto" if @next_page %>
</nav>
