<% content_for :title, "Recuperar senha" %>

<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-2xl font-semibold">Esqueceu a senha?</h1>

  <%= form_with url: passwords_path, class: "card space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "E-mail", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>
    <%= form.submit "Enviar instruções", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-4 text-sm"><%= link_to "Voltar para o login", new_session_path, class: "link" %></p>
</div>
