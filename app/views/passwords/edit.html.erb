<% content_for :title, "Nova senha" %>

<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-2xl font-semibold">Defina sua nova senha</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "card space-y-4" do |form| %>
    <div>
      <%= form.label :password, "Nova senha", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 6, maxlength: 72, class: "input" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Repita a nova senha", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <%= form.submit "Salvar", class: "btn-primary w-full" %>
  <% end %>
</div>
